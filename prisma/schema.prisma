// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  COLLECTOR
  SORTING_AGENT
  CLIENT_INDIVIDUAL
  CLIENT_COMPANY
  FARMER
  BUYER
  MUNICIPALITY
}

enum RequestStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MissionStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaterialType {
  PLASTIC_PET
  PLASTIC_HDPE
  ALUMINUM
  COPPER
  GLASS
  CARDBOARD
  ORGANIC
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CLIENT_INDIVIDUAL)
  
  // Ecological data
  ecologicalScore Int     @default(0)
  loyaltyPoints   Int     @default(0)
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  requests      CollectionRequest[] @relation("ClientRequests")
  missions      CollectionMission[] @relation("CollectorMissions")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CollectionRequest {
  id            String        @id @default(cuid())
  clientId      String
  client        User          @relation("ClientRequests", fields: [clientId], references: [id])
  
  type          MaterialType
  volumeEstimate Float?
  photoUrl      String?
  
  scheduledDate DateTime?
  status        RequestStatus @default(PENDING)
  
  latitude      Float?
  longitude     Float?
  address       String?
  
  missionId     String?
  mission       CollectionMission? @relation(fields: [missionId], references: [id])
  
  qrCode        String?       @unique
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model CollectionMission {
  id            String        @id @default(cuid())
  collectorId   String
  collector     User          @relation("CollectorMissions", fields: [collectorId], references: [id])
  
  status        MissionStatus @default(ASSIGNED)
  startTime     DateTime?
  endTime       DateTime?
  
  requests      CollectionRequest[]
  
  totalWeight   Float?
  distanceKm    Float?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SmartBin {
  id            String    @id @default(cuid())
  serialNumber  String    @unique
  latitude      Float
  longitude     Float
  fillLevel     Float     @default(0) // 0 to 100
  lastPing      DateTime  @default(now())
  status        String    @default("ACTIVE")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MaterialInventory {
  id            String    @id @default(cuid())
  type          MaterialType
  quantityKg    Float     @default(0)
  location      String?
  marketValue   Float?    // Price per kg
  
  updatedAt     DateTime  @updatedAt
}

model MarketplaceListing {
  id            String    @id @default(cuid())
  title         String
  description   String?
  price         Float
  type          MaterialType
  stock         Float
  sellerId      String    // Usually Admin or Sorting Center
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
